MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
PORT=5000
JWT_SECRET=change-me
TZ=Asia/Ho_Chi_Minh
UPLOAD_DIR=uploads

# Mail. Empty host keeps the sender in noop mode, which is the rule in D95.
# Development runs against a local capture, so no provider account is needed.
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ishop@localhost

# Push. Empty url means the sender only reports the queue (D33).
EXPO_PUSH_URL=
